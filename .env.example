# Copy to .env (gitignored). Owner-specific values live ONLY here, never in the repo.
OWNER_NAME=ntloso
OWNER_TZ=Africa/Johannesburg
# EQUITY=            # your account equity; leave blank to show the size formula instead of lots
ACCOUNT_CURRENCY=USD
RISK_PCT=0.5
SHARED_UNIT_MODE=block          # block -> RISK_UNIT_FULL | split -> 0% extra while unit is full
# RISK_GROUPS_JSON={"NAS100:short":"LONG_USD"}   # e.g. treat NAS short with the long-USD unit
DAILY_TOKEN_BUDGET=2000000
ALERT_CHANNEL=file              # file | telegram | email (telegram/email are DRY-RUN stubs)
ALERT_DIR=out/alerts
# TELEGRAM_CHAT_ID=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
AWS_REGION=us-east-1
PROJECT_NAME=ict-agentcore
# Filled by deploy scripts:
# GUARDRAIL_ID=
# GUARDRAIL_VERSION=
# RULES_KB_ID=
# TRANSCRIPTS_KB_ID=
# BACKTESTS_KB_ID=
# AGENTCORE_MEMORY_ID=
# AGENTCORE_RUNTIME_ARN=
